{
  "schema_version": 1,
  "owner": "tj-agents",
  "repositories": {
    "github-actions": {
      "rulesets": {
        "merge-policy": {
          "target": "branch",
          "enforcement": "active",
          "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
          "bypass_actors": [
            {"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request"},
            {"actor_id": 5548045, "actor_type": "Integration", "bypass_mode": "always"}
          ],
          "rules": [
            {"type": "deletion"},
            {"type": "non_fast_forward"},
            {"type": "pull_request", "parameters": {"required_approving_review_count": 1}},
            {"type": "required_status_checks", "parameters": {
              "strict_required_status_checks_policy": false,
              "required_status_checks": [
                {"context": "verify / hosts"},
                {"context": "verify / verify (ubuntu-latest)"},
                {"context": "verify / verify (windows-latest)"},
                {"context": "Verify the portable workflow writer (ubuntu-latest)"},
                {"context": "Verify the portable workflow writer (windows-latest)"}
              ]
            }}
          ]
        }
      }
    }
  }
}
